# === Database (자체 DB) ===
DATABASE_URL=postgres://postgres:postgres@localhost:5432/match_move

# === PLAB SQL Gateway ===
PLAB_API_BASE_URL=https://vibe.techin.pe.kr/api
PLAB_API_KEY=__set_me__

# === 발송: 채널톡 복붙 (ADR-013) ===
# 자동 발송 없음. 운영자가 admin/export에서 대상자별 메시지를 복사해 채널톡으로 수동 발송.
# 별도 환경변수 불필요.

# === Slack ===
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#match-move-test

# === Token ===
HMAC_SECRET=replace_with_at_least_32_chars_random_string_here

# === 운영 ===
TZ=Asia/Seoul
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# === Next.js (web) ===
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
