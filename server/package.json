{
  "name": "@match-move/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx ../scripts/migrate.ts",
    "dry-run": "tsx ../scripts/dry-run-extract.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "node-cron": "^4.0.7",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
